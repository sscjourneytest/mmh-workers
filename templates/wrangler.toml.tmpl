name = "__WORKER_NAME__"
main = "src/index.js"
compatibility_date = "2024-09-01"

# Fill this in after creating the D1 database on this exam's
# Cloudflare account: wrangler d1 create __DB_NAME__
# (or Dashboard -> D1 -> Create Database -> copy the ID it shows)
[[d1_databases]]
binding = "DB"
database_name = "__DB_NAME__"
database_id = "REPLACE_WITH_DATABASE_ID"

[vars]
ALLOWED_ORIGINS = "https://mockmatrixhub.in,https://www.mockmatrixhub.in,https://mockmatrixhub.pages.dev"
